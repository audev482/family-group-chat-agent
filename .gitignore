# Dependencies and build output. Both are regenerated by `pnpm install && pnpm build`,
# and `lib/` in particular must NOT be committed: the packages import each other
# through their built artifacts, so a stale committed `lib/` would be what a dependent
# package typechecks against.
node_modules/
*/lib/
*.tsbuildinfo

# Test and coverage output.
coverage/
.vitest/

# Credentials. deploy/.gitignore also covers deploy/secrets.yml; this is the
# belt-and-braces version, because the cost of getting it wrong is the family's mail
# password in a git history.
.env
.env.*
!.env.example
secrets.yml
*.pem
*.key

# Expense exports. `expenses_export` writes into the session's working directory, so
# running the butler from a clone would otherwise drop the family's ledger into the
# repo.
expenses-*.csv
expenses-*.json

# Editor and OS noise.
.DS_Store
*.swp
*~
.idea/
.vscode/

# Per-file secret drops (fill-secrets.sh writes here; never commit).
deploy/secrets/
