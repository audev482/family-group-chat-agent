{{ ansible_managed | comment }}
# The household's own patch layer, applied after every bundle layer.
#
# Each of the thirteen packages ships a patch that inserts its plugin row with
# sensible defaults. This file overrides those rows with what is true of *this*
# family — who they are, which server, which room. Nothing here disables or replaces
# a harness row, so a harness upgrade brings its changes through untouched.
#
# Regenerated by deploy/butler.yml from deploy/group_vars/all.yml. Edit that and
# re-run the play rather than editing this file, which will be overwritten.

# --- who the family is ------------------------------------------------------
# Configured once here and read by every other package, so a person spelled once is
# a person everywhere.
- id: household
  config:
    familyName: "{{ household.family_name }}"
    timezone: "{{ household.timezone }}"
    sharedCalendar: "{{ household.shared_calendar }}"
    choresCalendar: "{{ household.chores_calendar }}"
    members:
{% for key, member in household.members.items() %}
      {{ key }}:
        displayName: "{{ member.display_name }}"
        role: "{{ member.role }}"
{% if member.aliases | default([]) | length > 0 %}
        aliases: [{{ member.aliases | map('to_json') | join(', ') }}]
{% endif %}
{% if member.birthday | default('') | trim | length > 0 %}
        birthday: "{{ member.birthday }}"
{% endif %}
{% if member.discord_user_id | default('') | trim | length > 0 %}
        discordUserId: "{{ member.discord_user_id }}"
{% endif %}
{% if member.email | default('') | trim | length > 0 %}
        email: "{{ member.email }}"
{% endif %}
{% endfor %}
{% if household.occasions | default({}) | length > 0 %}
    # Dates that belong to the family rather than to one person, which is why they
    # are not on a member: a wedding anniversary would force an arbitrary choice.
    occasions:
{% for key, occasion in household.occasions.items() %}
      {{ key }}:
        name: "{{ occasion.name }}"
        date: "{{ occasion.date }}"
{% endfor %}
{% endif %}

# --- the boundary around the agent's own tool calls -------------------------
# This is a different boundary from the systemd confinement in the unit file. That one
# contains the butler process; this one contains what the *model* can do through its
# shell and filesystem tools, enforced by bubblewrap and Landlock in the kernel.
#
# It matters here more than in an interactive deployment, because this butler reads
# email — so instructions from outside the household reach the model, and the sandbox
# is what stands between such an instruction and the rest of the machine.
#
# workspaceRoot is pinned to the same directory as the unit's WorkingDirectory rather
# than left to process.cwd(), so the kernel boundary and the agent's own idea of its
# workspace cannot drift apart.
- id: sandbox-policy
  config:
    mode: "{{ sandbox_mode }}"
    workspaceRoot: "{{ butler_workspace }}"

# The base bundle pairs workspace-write with `approval: ask`, which delegates an
# escalation request to a composed interactive answerer. This butler runs unattended,
# so there is no answerer — and `ask` with none composed falls through to a fail-closed
# 'unavailable' rather than resolving cleanly.
#
# `never` is therefore the stricter setting, not the looser one: every escalation
# request resolves 'rejected' deterministically, and the model is told plainly not to
# ask. It cannot widen the sandbox, because nothing can. That is the correct headless
# stance — an approval prompt with nobody to answer it was never a control.
- id: approval
  config:
    policy: never

# --- transports -------------------------------------------------------------
# Each names a credential rather than carrying one.
#
# Note that a patch `config` REPLACES the row's whole config object rather than
# merging into it, so each block below restates every key it needs — including the
# ones the package's own patch already defaulted. Overriding a partial object would
# silently drop the rest.
- id: caldav
  config:
    defaultServer: home
    discoveryTtlMs: 300000
    servers:
      home:
        baseUrl: "{{ nextcloud.server }}"
        username: "{{ nextcloud.username }}"
        passwordRef: "NEXTCLOUD_APP_PASSWORD"

# Mail is account-shaped, and `preset: yahoo` supplies the IMAP and SMTP hosts and
# ports — so they are not repeated here, where a typo would be a connection failure
# with no obvious cause.
- id: mail
  config:
    defaultAccount: family
    accounts:
      family:
        address: "{{ mail.address }}"
        displayName: "{{ household.family_name }}"
        passwordRef: "YAHOO_APP_PASSWORD"
        preset: yahoo
    idleTtlMs: 300000
    timeoutMs: 20000
    maxBodyChars: 8000

- id: tricount
  config:
    tokenRef: "TRICOUNT_TOKEN"
{% if TRICOUNT_APP_ID | default('') | trim | length > 0 %}
    appId: "{{ TRICOUNT_APP_ID }}"
    publicKeyRef: "TRICOUNT_PUBLIC_KEY"
{% else %}
    # No device identity pinned yet: one is minted per process and reported once
    # through the tricount/device event. Copy it into secrets.yml and re-run.
{% endif %}

# --- the family room --------------------------------------------------------
# `channelIds` is a LIST: the channel plugin can watch more than one room. The
# briefing and the planner each take a single `channelId`, because they speak into
# exactly one.
- id: channel-discord
  config:
    tokenRef: "DISCORD_BOT_TOKEN"
    channelIds: ["{{ discord.channel_id }}"]
    respondTo: all
    allowDirectMessages: true
    typingIndicator: true
    channelName: discord

# --- the two things that speak without being asked --------------------------
- id: briefing
  config:
    channelId: "{{ discord.channel_id }}"
    time: "{{ briefing_time }}"
    days: 1
    includeChores: true
    includeMail: true
    choreLookaheadDays: 2
    skipWhenEmpty: false

- id: planner
  config:
    channelId: "{{ discord.channel_id }}"
    time: "{{ planning_time }}"
    planningWeekday: {{ planning_weekday }}
    workdays: [1, 2, 3, 4, 5]
    holidayLeadDays: 24
    birthdayLeadDays: 18
    anniversaryLeadDays: 24
    # Ask once more, then go quiet. Chasing gets the channel muted, which also loses
    # the morning briefing.
    maxNudges: {{ max_nudges }}
    nudgeGapDays: 3
    planWeekends: true
