{{ ansible_managed | comment }}
# The butler's credentials. Written by deploy/butler.yml from deploy/secrets.yml,
# owned by root, readable only by the {{ butler_group }} group.
#
# Every plugin reaches these by *reference*: the configuration names a credential,
# the credential provider reads this environment, and the secret itself never
# appears in a config file, a log line or an event. That is what lets a rotated app
# password take effect on the next operation rather than the next restart.

# The model provider.
DEEPSEEK_API_KEY={{ DEEPSEEK_API_KEY }}

# Nextcloud, for the calendar, the chore list, and the planner's cycle tasks.
NEXTCLOUD_APP_PASSWORD={{ NEXTCLOUD_APP_PASSWORD }}

# The family mailbox.
YAHOO_APP_PASSWORD={{ YAHOO_APP_PASSWORD }}

# The family room.
DISCORD_BOT_TOKEN={{ DISCORD_BOT_TOKEN }}

# The shared expense ledger. The token grants full read and write access to it.
TRICOUNT_TOKEN={{ TRICOUNT_TOKEN }}
{% if TRICOUNT_PUBLIC_KEY | default('') | trim | length > 0 %}
# The pinned device identity, so a restart does not register a new anonymous user.
TRICOUNT_PUBLIC_KEY={{ TRICOUNT_PUBLIC_KEY | replace('\n', '\\n') }}
{% else %}
# TRICOUNT_PUBLIC_KEY is unset, so a device identity is minted per process. Read it
# from the tricount/device journal line and pin it in secrets.yml.
{% endif %}

# Keep all harness state — profiles, sessions, transcripts — under one root.
DSH_HOME={{ butler_home }}
NODE_ENV=production
